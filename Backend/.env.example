# Copy to Backend/.env for local development. Do not commit real secrets.
VLLM_BASE_URL=http://221.12.22.187:30964/v1
VLLM_API_KEY=replace-with-your-vllm-api-key
# Optional. If empty, the backend asks /v1/models and uses the first model.
VLLM_MODEL=

BACKEND_DB_PATH=Backend/data/pathmate.db
MAX_PDF_BYTES=52428800
REQUEST_TIMEOUT_SECONDS=20
LLM_TIMEOUT_SECONDS=120
ENABLE_OCR=false
OCR_LANGUAGE=chi_sim+eng
OCR_MAX_PAGES=6

# Optional server-side authenticated sync fallback.
# Prefer passing the current WKWebView cookie header from iOS per sync request.
ZJU_LEARNING_COOKIE=
